{
  "_help": [
    "Each theme has a name and lists of words or phrases to look for.",
    "keywords: match from the start of a word, so 'crash' also finds 'crashed' and 'crashes'. End a word with $ to match the whole word only.",
    "negative_keywords: phrases that are a complaint on their own, like 'charged twice'.",
    "regex and negative_regex: optional regular expressions, same idea.",
    "polarity: 'neutral' (default) means plain keywords only count when the same part of the sentence has a negative word, like 'rude' or 'broken'. 'negative' means plain keywords always count as complaints.",
    "Words are matched in lowercase. A match with 'not', 'no', 'never' or 'zero' just before it is ignored, except in reviews of 2 stars or less."
  ],
  "themes": {
    "Price and value": {
      "keywords": ["price", "pricing", "cost", "fee", "fees", "value for money", "subscription cost"],
      "negative_keywords": ["expensive", "overpriced", "pricey", "rip off", "ripoff", "not worth", "poor value", "bad value", "price hike", "price increase", "too much money", "went up in price", "price went up", "prices went up", "price keeps going up", "prices keep going up", "creeping up"]
    },
    "Billing and refunds": {
      "keywords": ["billing", "billed", "invoice", "charge", "charged", "payment", "refund", "credit card"],
      "negative_keywords": ["double charge", "charged twice", "charged me twice", "charged again", "charged me again", "took payment again", "took payment twice", "billed twice", "billed two times", "double billed", "overcharged", "duplicate charge", "second charge", "extra charge", "unexpected charge", "unauthorized charge", "wrong amount", "no refund", "never got a refund", "never got my refund"]
    },
    "Bugs and crashes": {
      "polarity": "negative",
      "keywords": ["crash", "bug", "glitch", "freezes", "freezing", "froze", "error", "blank screen", "force close", "app broke", "app is broken", "won't load", "won't open", "doesn't load", "not loading"]
    },
    "Slow performance": {
      "polarity": "negative",
      "keywords": ["sluggish", "laggy", "lag$", "lags$", "lagging", "takes forever", "takes ages", "long time to load", "slow to load", "slow loading", "load time", "loading time", "spinner"],
      "regex": ["\\b(app|site|website|page|pages|checkout|dashboard|screen|screens|search|everything)\\b[^.!?;,]{0,25}\\bslow", "\\bslow (app|site|website|page|pages|checkout|dashboard)\\b", "\\bslow (the|this|that|your) (app|site|website|page|checkout|dashboard)\\b", "\\bso slow that\\b"]
    },
    "Login and account": {
      "keywords": ["login", "log in", "sign in", "password", "verification code", "two-factor", "2fa"],
      "negative_keywords": ["locked out", "logging me out", "logged me out", "can't log in", "cannot log in", "can't sign in", "couldn't log in", "unable to log in", "won't let me log in", "reset link", "never got the code"]
    },
    "Customer support response": {
      "keywords": ["support", "customer service", "customer care", "help desk", "live chat", "chatbot", "agent", "get back to me", "email back"],
      "negative_keywords": ["no reply", "no response", "never replied", "never responded", "never heard back", "not heard back", "haven't heard back", "not replied", "hasn't replied", "haven't replied", "not responded", "hasn't responded", "didn't respond", "didn't reply", "didn't answer", "unanswered", "ignored", "still waiting for a reply", "still waiting for an answer", "still waiting for a response", "days to reply", "days to respond", "days to answer", "weeks to reply", "weeks to respond", "on hold", "nobody answered", "no one answered"]
    },
    "Missing feature": {
      "keywords": ["feature request", "missing feature", "lacks", "lacking"],
      "negative_keywords": ["wish i could", "wish it had", "wish it would", "wish there was", "wish there were", "wish they would", "wish you would", "please add", "would be nice", "would love to be able", "no way to", "no option to", "doesn't let me", "should add", "needs an option"]
    },
    "Onboarding and setup": {
      "keywords": ["setup", "set up", "onboarding", "tutorial", "getting started", "instructions"],
      "negative_keywords": ["hard to figure out", "couldn't figure out", "could not figure out", "no instructions", "didn't understand", "not intuitive", "hard to set up"],
      "negative_regex": ["\\b(setup|set up|onboarding|tutorial|instructions|getting started|first screen|sign up)\\b[^.!?;,]{0,30}\\b(confus|unclear|hard|difficult|missing)"]
    },
    "Delivery and shipping": {
      "keywords": ["delivery", "shipping", "shipment", "courier", "carrier", "parcel", "tracking"],
      "negative_keywords": ["arrived late", "came late", "was late", "were late", "delivered late", "day late", "days late", "weeks late", "arrived damaged", "arrived broken", "never arrived", "didn't arrive", "didn't show up", "lost in transit", "wrong address", "late delivery", "delayed", "left outside", "left it outside", "never got the box", "never got my box", "never got my order", "never got the package", "never got my package", "never received my order", "never received the box", "never received my box", "never received my package"],
      "regex": ["waited \\d+ (days|weeks)"]
    },
    "Product quality": {
      "keywords": ["quality"],
      "negative_keywords": ["defective", "faulty", "poorly made", "flimsy", "fell apart", "not as described", "not as advertised", "low quality", "poor quality", "cheaply made", "stale", "past its best before", "past the expiry date", "spoiled", "rotten", "tastes bad", "tasted bad"]
    },
    "Cancellation difficulty": {
      "keywords": ["cancel", "cancellation", "unsubscribe", "auto-renew", "renewal", "end my subscription"],
      "negative_keywords": ["can't cancel", "cannot cancel", "couldn't cancel", "could not cancel", "no clear way to end", "no clear way to cancel", "hard to cancel", "difficult to cancel", "impossible to cancel", "won't let me cancel", "no cancel button", "just to cancel", "kept charging", "kept billing", "keeps charging", "still charging"]
    }
  }
}
